# Copy this file to .env and adjust as needed. No real secrets belong in this repo.

# --- Postgres (used by backend/Prisma) ---
DATABASE_URL="postgresql://photosphere:photosphere@localhost:5432/photosphere?schema=public"

# --- Redis (queue/cache; not used by auth yet, reserved for Week 3-4 BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- MinIO (S3-compatible mock; unused by auth, reserved for Week 3-4 upload pipeline) ---
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="photosphere"
MINIO_SECRET_KEY="photosphere123"
MINIO_BUCKET="photosphere-dev"
MINIO_USE_SSL="false"

# --- Backend server ---
NODE_ENV="development"
PORT="4000"

# --- Sessions (opaque token, not JWT) ---
SESSION_TOKEN_TTL_HOURS="168"

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
FRONTEND_ORIGIN="http://localhost:3000"
