{
  "name": "@photosphere/backend",
  "version": "0.1.1",
  "private": true,
  "description": "PhotoSphere AI backend (Node/Express/Prisma) - local-first MVP",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node scripts/start.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1084.0",
    "@aws-sdk/client-s3": "^3.1078.0",
    "@aws-sdk/cloudfront-signer": "^3.1088.0",
    "@aws-sdk/s3-request-presigner": "^3.1078.0",
    "@prisma/client": "^5.20.0",
    "archiver": "^7.0.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.79.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.1"
  },
  "overrides": {
    "ioredis": "$ioredis"
  }
}
